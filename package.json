{
  "name": "forge-codex-workspace",
  "version": "1.0.26",
  "license": "MIT",
  "description": "Forge desktop AI workspace for Codex, Claude Code, and external APIs",
  "author": "Forge",
  "private": true,
  "type": "module",
  "main": "desktop.cjs",
  "scripts": {
    "start": "node server.mjs",
    "desktop": "electron .",
    "dist:win": "electron-builder --win nsis",
    "browser:install": "node build/install-browser.cjs",
    "predist:win": "node build/install-browser.cjs"
  },
  "devDependencies": {
    "@openai/codex": "^0.159.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.285",
    "@playwright/mcp": "0.0.83"
  },
  "build": {
    "appId": "com.forge.codexworkspace",
    "productName": "Forge",
    "asar": true,
    "files": [
      "desktop.cjs",
      "desktop-preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "server.mjs",
        "to": "forge/server.mjs"
      },
      {
        "from": "free-router.mjs",
        "to": "forge/free-router.mjs"
      },
      {
        "from": "responses-bridge.mjs",
        "to": "forge/responses-bridge.mjs"
      },
      {
        "from": "anthropic-provider.mjs",
        "to": "forge/anthropic-provider.mjs"
      },
      {
        "from": "provider-auth.mjs",
        "to": "forge/provider-auth.mjs"
      },
      {
        "from": "provider-secrets.mjs",
        "to": "forge/provider-secrets.mjs"
      },
      {
        "from": "node_modules/@anthropic-ai/claude-agent-sdk",
        "to": "forge/node_modules/@anthropic-ai/claude-agent-sdk",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public",
        "to": "forge/public"
      },
      {
        "from": "build/icon.ico",
        "to": "forge/icon.ico"
      },
      {
        "from": "node_modules/@openai/codex-win32-x64/vendor",
        "to": "codex/vendor",
        "filter": [
          "**/*",
          "!**/voice/**"
        ]
      },
      {
        "from": "browser-config.mjs",
        "to": "forge/browser-config.mjs"
      },
      {
        "from": "browser-mcp.mjs",
        "to": "forge/browser-mcp.mjs"
      },
      {
        "from": "computer-use-mcp.mjs",
        "to": "forge/computer-use-mcp.mjs"
      },
      {
        "from": "node_modules/@playwright/mcp",
        "to": "forge/node_modules/@playwright/mcp",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/playwright",
        "to": "forge/node_modules/playwright",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/playwright-core",
        "to": "forge/node_modules/playwright-core",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/browser",
        "to": "forge/browser",
        "filter": [
          "**/*",
          "!**/.links/**",
          "!**/*.pdb"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "Forge-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Forge"
    }
  }
}
